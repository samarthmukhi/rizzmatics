# ── Rizzmatics privacy firewall ──────────────────────────────────
# Real conversations NEVER leave your machine. If it looks like data,
# it does not get committed. The public repo ships synthetic demos only.
*.txt
*.csv
*.json
/data/*
/raw/
/processed/

# ...but we DO want the synthetic demo data to ship. Re-include the demo
# directory FIRST, then the files under it (git can't un-ignore a file whose
# parent directory is still excluded — order and the leading `!dir/` matter).
!/data/demo/
!/data/demo/**

# requirements.txt happens to end in .txt but is not chat data — keep it.
!/requirements.txt

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Environments ─────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── Rizzmatics // After Hours (PRIVATE — never commit) ───────────
# The private lore package and its secrets live only on the local/private
# build. The public repository must contain none of it: no protocol
# vocabulary, no clue, no birthdays, no password. Guarded by
# scripts/check_no_private_leak.py + tests/test_public_private_separation.py.
/private/**
/private/
.streamlit/secrets.toml
.streamlit/

# ── OS / editor cruft ────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
